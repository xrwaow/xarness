/* Hide every scrollbar app-wide; wheel/key scrolling still works. */
Widget {
    scrollbar-size: 0 0;
}

Screen {
    layout: vertical;
    background: $c-bg;
    /* The diff pane owns scrolling when a diff is open; never show the
       screen-level (outer) scrollbar next to it. Wheel/key scrolling of the
       screen still works if the content ever exceeds the terminal. */
    scrollbar-size: 0 0;
}

#chat-log {
    height: 1fr;
    padding: 0;
    background: $c-bg;
    /* NOTE: transcript text colors do NOT come from CSS — the presenter
       paints raw strips and gives every cell an explicit foreground base
       (see Presenter.present in flow.py). The background deliberately stays
       unstyled on text cells: a baked bgcolor would defeat Textual's
       screen--selection highlight, so the bg comes from this rule instead. */
    scrollbar-size: 0 0; /* hide the scrollbar visual; wheel/key scrolling still works */
}

StatusBar {
    height: 1;
    background: $c-bg;
    padding: 0;
}

GeneratingBar {
    display: none;
    width: auto;
    height: 1;
    color: $c-accent;
}

GeneratingBar.active {
    display: block;
}

#input-wrap {
    height: auto;
    padding: 0;
}

#input-row {
    height: auto;
    align-vertical: middle;
}

#input-prompt {
    width: 1;
    height: 100%;
    background: $c-surface;
    color: $c-muted;
    content-align: left middle;
}

ChatInput {
    height: auto;
    min-height: 3;
    max-height: 8;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 1 1 1 1;
}

/* Text selection uses the theme's highlight color instead of Textual's blue. */
Screen > .screen--selection {
    background: $c-highlight;
    color: $c-bg;
}

SuggestionPopup {
    height: auto;
    max-height: 8;
    background: $c-surface;
    display: none;
    /* OptionList's default tall border + padding render as stray vertical
       bars against the input; keep the popup flat. The scrollbar visual is
       hidden too — arrow-key highlight (and the wheel) still scroll it. */
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

SuggestionPopup > .option-list--option {
    color: $c-text;
    padding: 0 1;
}

SuggestionPopup > .option-list--option-highlighted {
    background: $c-border;
    color: $c-text;
}

SuggestionPopup > .option-list--option-hover {
    background: $c-surface;
    color: $c-text;
}

SuggestionPopup.visible {
    display: block;
}

DiffSummary {
    display: none;
    height: auto;
    background: $c-surface;
    padding: 0;
}

DiffSummary.visible {
    display: block;
    background: $c-bg;
}

#diff-summary-row {
    height: auto;
}

#diff-summary-text {
    width: 1fr;
    text-overflow: ellipsis;
    color: $c-text;
    text-style: bold;
}

#diff-summary-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

#diff-summary-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

DiffSummary:hover #diff-summary-row,
.diff-file-row:hover {
    text-style: underline;
}

/* Expanded: the whole bar (summary, file list, diff pane) sits on a
   dimmed, elevated background — nothing else changes. */
DiffSummary.expanded {
    background: $c-surface;
}

AskBar {
    display: none;
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 1;
}

AskBar.visible {
    display: block;
    /* Separator between the question and the answer input below. */
    border-bottom: solid $c-border;
}

#diff-body {
    display: none;
    height: auto;
}

DiffSummary.expanded #diff-body {
    display: block;
}

#diff-files {
    height: auto;
}

.diff-file-row {
    height: auto;
}

.diff-file-row.active {
    background: $c-border;
}

.diff-file-name {
    width: 1fr;
    text-overflow: ellipsis;
    color: $c-text;
}

.diff-file-new {
    width: auto;
    margin-left: 1;
    color: $c-accent;
    text-style: italic;
}

.diff-file-source {
    width: auto;
    margin-left: 1;
    text-style: italic;
}

.diff-file-source.agent {
    color: $c-muted;
}

.diff-file-source.drift {
    color: $c-warning;
}

.diff-file-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

.diff-file-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

#diff-content {
    display: none;
    height: auto;
    max-height: 24;
    overflow-y: auto;
    /* No scrollbar visual: the pane stays keyboard/wheel scrollable, and the
       gutter would eat width from every diff line. */
    scrollbar-size: 0 0;
    /* Textual shows a spurious horizontal scrollbar on scroll containers
       even with no horizontal overflow; diff lines wrap, so it is useless. */
    overflow-x: hidden;
    color: $c-text;
    /* The open diff's code pane sits on the normal background, contrasting
       with the dimmed expanded bar around it. */
    background: $c-bg;
    border-top: solid $c-border;
}

#diff-content.show {
    display: block;
}

#diff-content:focus {
    border-top: solid $c-status;
}

#diff-text {
    width: 1fr;
}

/* Shared chrome for every popup: titled surface panel and search field. */
.modal-panel {
    height: auto;
    background: $c-surface;
    padding: 1 2;
}

.modal-title {
    color: $c-muted;
    text-style: bold;
    margin-bottom: 1;
}

.modal-input {
    height: 1;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

.modal-input > .input--placeholder {
    color: $c-muted;
}

/* Textual's Input tints the background 5% $foreground while focused, which
   renders as a darker box inside the surface modal; kill it. */
.modal-input:focus {
    background-tint: transparent;
}

#confirm-modal {
    width: 64;
}

#confirm-title {
    color: $c-text;
}

/* The drift summary: a distinct inset block so the "what changed" detail
   reads apart from the question, with its own scroll for long lists. */
#confirm-detail {
    color: $c-text;
    background: $c-bg;
    border-left: thick $c-warning;
    padding: 0 1;
    margin-bottom: 1;
    max-height: 12;
    overflow-y: auto;
    scrollbar-size: 0 0;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

/* Textual ships blue buttons out of the box; recolor every state to the
   active palette so the modal matches the rest of the UI. */
#confirm-buttons > Button {
    width: auto;
    min-width: 14;
    margin-left: 2;
    padding: 0 2;
    border: none;
    background: $c-border;
    color: $c-text;
}

#confirm-buttons > Button:hover,
#confirm-buttons > Button:focus,
#confirm-buttons > Button.-active {
    background: $c-highlight;
    color: $c-bg;
    text-style: bold;
}

#confirm-buttons > Button#confirm-yes {
    background: $c-accent;
    color: $c-bg;
    text-style: bold;
}

#confirm-buttons > Button#confirm-yes:hover,
#confirm-buttons > Button#confirm-yes:focus,
#confirm-buttons > Button#confirm-yes.-active {
    background: $c-accent2;
    color: $c-bg;
}

ConfirmScreen, RefsScreen, ListPicker {
    align: center middle;
}

#refs-modal {
    width: 72;
    max-height: 24;
}

#refs-add-label {
    color: $c-muted;
}

#refs-empty, .refs-mount {
    color: $c-muted;
}

#refs-list {
    height: auto;
    max-height: 16;
    overflow-y: auto;
}

.refs-row {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.refs-row-top {
    height: 1;
}

.refs-path {
    width: 1fr;
    color: $c-text;
}

.refs-remove {
    width: 3;
    height: 1;
    padding: 0;
    border: none;
    background: $c-surface;
    color: $c-muted;
}

.refs-remove:hover, .refs-remove:focus, .refs-remove.-active {
    background: $c-border;
    color: $c-text;
}

#picker-modal {
    width: 52;
    max-height: 20;
}

#picker-list {
    /* The default height: 1fr collapses to a single visible row inside the
       auto-height modal — one entry at a time, the rest only reachable by
       scrolling. Also: the widgets default to Textual's own dark $surface,
       which renders as a big dark block inside the auto-height modal. */
    height: auto;
    max-height: 16;
    background: $c-surface;
    border: none;
    padding: 0;
    color: $c-text;
}

#picker-list > .option-list--option {
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

#picker-list > .option-list--option-hover,
#picker-list > .option-list--option-highlighted {
    background: $c-border;
    color: $c-text;
    text-style: bold;
}

#steer-queue-bar {
    display: none;
    height: auto;
    background: $c-surface;
    color: $c-muted;
    padding: 0 1;
}

#steer-queue-bar.visible {
    display: block;
    /* Separator between the queued messages and the input below. */
    border-bottom: solid $c-border;
}

#steer-queue-bar > .steer-item {
    width: 1fr;
}

#steer-queue-bar > .steer-hint {
    color: $c-accent2;
    text-style: italic;
}


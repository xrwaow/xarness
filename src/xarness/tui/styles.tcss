/* Hide every scrollbar app-wide; wheel/key scrolling still works. */
Widget {
    scrollbar-size: 0 0;
}

Screen {
    layout: vertical;
    background: $c-bg;
    /* The diff pane owns scrolling when a diff is open; never show the
       screen-level (outer) scrollbar next to it. Wheel/key scrolling of the
       screen still works if the content ever exceeds the terminal. */
    scrollbar-size: 0 0;
}

#chat-log {
    height: 1fr;
    padding: 0;
    background: $c-bg;
    scrollbar-size: 0 0; /* hide the scrollbar visual; wheel/key scrolling still works */
}

.msg {
    margin-bottom: 1;
}

/* Tool call blocks are spacing-free: they pack tightly against whatever
   precedes/follows them. Blank lines around a round are owned by the
   cot/assistant/user messages instead. */
.msg.toolcall {
    margin-bottom: 0;
}

/* A cot/assistant message that directly follows tool call blocks still
   gets a separating blank line (added by app.py when mounting). */
AssistantMessage.after-tools,
ThinkingBlock.after-tools {
    margin-top: 1;
}

UserMessage {
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 0;
}

.user-row {
    height: auto;
}

.user-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.user-content {
    width: 1fr;
    color: $c-text;
}

/* Image attachment chip: dimmed background so it reads as metadata, not
   message text. One chip per attached image, on its own line. */
.user-image-chip {
    width: auto;
    margin-left: 2;
    padding: 0 1;
    background: $c-border;
    color: $c-muted;
}

/* Click-to-undo affordance: hidden until the message is clicked. Sized to
   its text (not the full line) so only the label itself is clickable. */
.user-undo {
    display: none;
    width: auto;
    height: auto;
    padding: 0 0 0 2;
    color: $c-muted;
}

UserMessage.undo-armed .user-undo {
    display: block;
}

.user-undo:hover {
    color: $c-highlight;
    text-style: underline;
}

AssistantMessage {
    height: auto;
    color: $c-text;
    padding: 0 1;
}

.assistant-row {
    height: auto;
}

.assistant-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.assistant-live {
    width: 1fr;
    color: $c-text;
}

.assistant-md {
    width: 1fr;
    height: auto;
    color: $c-text;
    margin: 0;
    overflow-y: hidden;
}

.assistant-content {
    width: 1fr;
    height: auto;
}

ThinkingBlock,
PendingIndicator {
    height: auto;
    padding: 0 1;
}

.thinking-summary {
    height: auto;
}

.thinking-elapsed {
    color: $c-muted;
}

.thinking-done-summary {
    color: $c-muted;
}

.thinking-row {
    height: auto;
    display: none;
}

ThinkingBlock.expanded .thinking-row {
    display: block;
}

.thinking-marker {
    width: 2;
}

.thinking-text {
    width: 1fr;
    color: $c-reasoning;
    text-style: italic;
}

ThinkingBlock:hover .thinking-summary,
ToolCallBlock:hover .toolcall-summary {
    text-style: underline;
    color: $c-highlight;
}

.pending-elapsed {
    color: $c-muted;
}

ToolCallBlock {
    height: auto;
    padding: 0 1;
}

.toolcall-summary {
    height: auto;
}

.toolcall-dot {
    width: 1;
    margin-right: 1;
}

.toolcall-summary-text {
    color: $c-text;
}

.toolcall-row {
    height: auto;
    display: none;
    /* The left bar lives on the row itself so it spans the full height of
       the expanded body (the empty marker Static is only ever one line
       tall, so its own border stopped after the first line). */
    border-left: solid $c-border;
}

ToolCallBlock.expanded .toolcall-row {
    display: block;
}

.toolcall-marker {
    /* Pure spacing now — the vertical bar is the row's border-left. One
       cell, so the body starts flush: '|output'. */
    width: 1;
}

.toolcall-body {
    width: 1fr;
    color: $c-muted;
}

ToolWritingIndicator {
    height: auto;
    padding: 0 1;
}

/* Every MessageLine kind (ErrorLine/NoticeLine are subclasses) is padded
   the same way; the class rules below only pick the color. */
MessageLine {
    padding: 0 1;
}

.msg.error {
    color: $c-error;
}

.msg.notice,
.msg.info {
    color: $c-muted;
}

.msg.warn {
    color: $c-warning;
}

.msg.success {
    color: $c-success;
}

StatusBar {
    height: 1;
    background: $c-bg;
    padding: 0;
}

GeneratingBar {
    display: none;
    width: auto;
    height: 1;
    color: $c-accent;
}

GeneratingBar.active {
    display: block;
}

#input-wrap {
    height: auto;
    padding: 0;
}

#input-row {
    height: auto;
    align-vertical: middle;
}

#input-prompt {
    width: 1;
    height: 100%;
    background: $c-surface;
    color: $c-muted;
    content-align: left middle;
}

ChatInput {
    height: auto;
    min-height: 3;
    max-height: 8;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 1 1 1 1;
}

MarkdownFence {
    margin: 0;
    background: $c-bg;
}

#code-content {
    padding: 1 0 !important;
}

MarkdownBlock {
    padding: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

Markdown {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

MarkdownDocument {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

/* List bullets/numbers render as plain text color, not the theme accent. */
MarkdownBullet {
    color: $c-text !important;
}

/* Textual styles inline code from its own theme's dark/light variant; we
   never register a Textual theme, so the dark variant (yellow on white)
   always wins. Pin it to the palette instead. !important beats the
   higher-specificity `MarkdownBlock:dark >` built-in rule. */
MarkdownBlock > .code_inline {
    background: $c-surface !important;
    color: $c-accent2 !important;
}

/* Text selection uses the theme's highlight color instead of Textual's blue. */
Screen > .screen--selection {
    background: $c-highlight;
    color: $c-bg;
}

SuggestionPopup {
    height: auto;
    max-height: 8;
    background: $c-surface;
    display: none;
    /* OptionList's default tall border + padding render as stray vertical
       bars against the input; keep the popup flat. The scrollbar visual is
       hidden too — arrow-key highlight (and the wheel) still scroll it. */
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

SuggestionPopup > .option-list--option {
    color: $c-text;
    padding: 0 1;
}

SuggestionPopup > .option-list--option-highlighted {
    background: $c-border;
    color: $c-text;
}

SuggestionPopup > .option-list--option-hover {
    background: $c-surface;
    color: $c-text;
}

SuggestionPopup.visible {
    display: block;
}

DiffSummary {
    display: none;
    height: auto;
    background: $c-surface;
    padding: 0;
}

DiffSummary.visible {
    display: block;
    background: $c-bg;
}

#diff-summary-row {
    height: auto;
}

#diff-summary-text {
    width: 1fr;
    text-overflow: ellipsis;
    color: $c-text;
    text-style: bold;
}

#diff-summary-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

#diff-summary-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

DiffSummary:hover #diff-summary-row,
.diff-file-row:hover {
    text-style: underline;
}

/* Expanded: the whole bar (summary, file list, diff pane) sits on a
   dimmed, elevated background — nothing else changes. */
DiffSummary.expanded {
    background: $c-surface;
}

AskBar {
    display: none;
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 1;
}

AskBar.visible {
    display: block;
    /* Separator between the question and the answer input below. */
    border-bottom: solid $c-border;
}

#diff-body {
    display: none;
    height: auto;
}

DiffSummary.expanded #diff-body {
    display: block;
}

#diff-files {
    height: auto;
}

.diff-file-row {
    height: auto;
}

.diff-file-row.active {
    background: $c-border;
}

.diff-file-name {
    width: 1fr;
    text-overflow: ellipsis;
    color: $c-text;
}

.diff-file-new {
    width: auto;
    margin-left: 1;
    color: $c-accent;
    text-style: italic;
}

.diff-file-source {
    width: auto;
    margin-left: 1;
    text-style: italic;
}

.diff-file-source.agent {
    color: $c-muted;
}

.diff-file-source.drift {
    color: $c-warning;
}

.diff-file-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

.diff-file-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

#diff-content {
    display: none;
    height: auto;
    max-height: 24;
    overflow-y: auto;
    /* No scrollbar visual: the pane stays keyboard/wheel scrollable, and the
       gutter would eat width from every diff line. */
    scrollbar-size: 0 0;
    /* Textual shows a spurious horizontal scrollbar on scroll containers
       even with no horizontal overflow; diff lines wrap, so it is useless. */
    overflow-x: hidden;
    color: $c-text;
    /* The open diff's code pane sits on the normal background, contrasting
       with the dimmed expanded bar around it. */
    background: $c-bg;
    border-top: solid $c-border;
}

#diff-content.show {
    display: block;
}

#diff-content:focus {
    border-top: solid $c-status;
}

#diff-text {
    width: 1fr;
}

#confirm-modal {
    width: 64;
    height: auto;
    background: $c-surface;
    padding: 1 2;
}

#confirm-title {
    color: $c-text;
    text-style: bold;
    margin-bottom: 1;
}

/* The drift summary: a distinct inset block so the "what changed" detail
   reads apart from the question, with its own scroll for long lists. */
#confirm-detail {
    color: $c-text;
    background: $c-bg;
    border-left: thick $c-warning;
    padding: 0 1;
    margin-bottom: 1;
    max-height: 12;
    overflow-y: auto;
    scrollbar-size: 0 0;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

/* Textual ships blue buttons out of the box; recolor every state to the
   active palette so the modal matches the rest of the UI. */
#confirm-buttons > Button {
    width: auto;
    min-width: 14;
    margin-left: 2;
    padding: 0 2;
    border: none;
    background: $c-border;
    color: $c-text;
}

#confirm-buttons > Button:hover,
#confirm-buttons > Button:focus,
#confirm-buttons > Button.-active {
    background: $c-highlight;
    color: $c-bg;
    text-style: bold;
}

#confirm-buttons > Button#confirm-yes {
    background: $c-accent;
    color: $c-bg;
    text-style: bold;
}

#confirm-buttons > Button#confirm-yes:hover,
#confirm-buttons > Button#confirm-yes:focus,
#confirm-buttons > Button#confirm-yes.-active {
    background: $c-accent2;
    color: $c-bg;
}

ResumeScreen, PickerScreen, ConfirmScreen, ContainerSettingsScreen {
    align: center middle;
}

#resume-modal, #picker-modal, #container-modal {
    width: 52;
    height: auto;
    max-height: 20;
    background: $c-surface;
    padding: 1 2;
}

#container-modal {
    max-height: 30;
}

/* TabbedContent's tabs: recolor to the palette (default is Textual blue). */
#container-tabs {
    height: auto;
    padding: 0;
}

#container-tabs Tabs {
    background: $c-surface;
    border-bottom: hidden;
    height: 1;
    padding: 0;
}

#container-tabs ContentTab {
    background: $c-border;
    color: $c-muted;
    padding: 0 1 0 0;
    border: none;
    height: 1;
    text-style: not dim;
    &:ansi {
        text-style: not dim;
    }
}

#container-tabs ContentTab.-active {
    color: $c-accent;
    background: $c-border;
    text-style: not dim bold;
    &:ansi {
        text-style: not dim bold;
    }
}

#container-tabs ContentTab:hover {
    color: $c-accent;
    background: $c-border;
    text-style: not dim;
    &:ansi {
        text-style: not dim;
    }
}

#container-tabs ContentTab.-active:hover {
    color: $c-accent;
    background: $c-border;
    text-style: not dim bold;
    &:ansi {
        text-style: not dim bold;
    }
}

/* Kill Textual's default blue block-cursor look when the tab strip has
   focus (it kicks in on click): keep the palette's muted/accent scheme. */
#container-tabs Tabs:focus ContentTab.-active {
    color: $c-accent;
    background: $c-border;
    text-style: not dim bold;
    &:ansi {
        text-style: not dim bold;
    }
}

#container-tabs Tabs:focus .underline--bar {
    background: $c-border;
}

/* Policy toggles: one button per row — dimmed when off, accent when on. */
.container-toggle {
    height: 1;
    min-width: 4;
    border: none;
    background: transparent;
    color: $c-muted;
    text-style: none;
}

.container-toggle:hover,
.container-toggle:focus {
    background: transparent;
    color: $c-text;
    text-style: none;
}

.container-toggle.is-on {
    color: $c-accent;
    text-style: bold;
}

#container-tabs Tabs .underline--bar {
    color: $c-accent;      /* highlight segment */
    background: $c-border; /* track */
}

#container-tabs TabPane {
    background: $c-surface;
    padding: 0;
}

#container-title {
    color: $c-text;
    text-style: bold;
    margin-bottom: 1;
}

.container-row {
    height: 1;
}

.container-limit-input {
    width: 12;
    height: 1;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0;
    margin-left: 1;
}

/* Table layout: fixed-width name column, values left-aligned in a fixed
   column so on/off and numbers line up instead of hugging the right edge. */
.container-label {
    width: 20;
    color: $c-text;
}

.container-toggle {
    margin-left: 1;
}

/* Textual's Switch ships blue/green $panel shades; the slider is a component
   class ("switch--slider"). One color per state, no focus/hover variation:
   muted track when off, accent when on. No default border or focus tint. */
#container-modal Switch {
    border: none;
    background: transparent;
    background-tint: transparent;
    padding: 0;
}

#container-modal Switch .switch--slider {
    color: $c-muted;
    background: $c-border;
}

#container-modal Switch.-on .switch--slider {
    color: $c-accent;
    background: $c-border;
}

#container-refs-title,
#defaults-refs-title {
    color: $c-muted;
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

#container-refs,
#defaults-refs {
    height: auto;
    max-height: 8;
    background: $c-surface;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

#container-refs > ListItem,
#defaults-refs > ListItem {
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    height: auto;
}

/* One ref row: full host path on top, mount + rw switch + ✕ beneath. */
.container-ref-item {
    height: auto;
}

.container-ref-path {
    color: $c-text;
    width: 1fr;
}

.container-ref-mount {
    color: $c-muted;
    width: 1fr;
}

.container-ref-controls {
    height: 1;
}

.container-ref-controls > Switch {
    border: none;
    background: transparent;
    background-tint: transparent;
    padding: 0;
}

.container-ref-controls > Switch .switch--slider {
    color: $c-muted;
    background: $c-border;
}

.container-ref-controls > Switch.-on .switch--slider {
    color: $c-success;
    background: $c-border;
}

.container-rm {
    min-width: 3;
    width: auto;
    height: 1;
    border: none;
    background: transparent;
    color: $c-muted;
    padding: 0 1;
}

.container-rm:hover,
.container-rm:focus {
    background: $c-error;
    color: $c-bg;
    text-style: bold;
}

/* The add-ref bar: same shape as the /sessions search input — full width,
   borderless, surface background; Enter adds the ref. */
#container-ref-input,
#defaults-ref-input {
    width: 1fr;
    height: 1;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

#container-ref-input:focus,
#defaults-ref-input:focus {
    background-tint: transparent;
}

#container-ref-input > .input--placeholder,
#defaults-ref-input > .input--placeholder {
    color: $c-muted;
}

#resume-title, #picker-title {
    color: $c-muted;
    text-style: bold;
    margin-bottom: 1;
}

#resume-search {
    height: 1;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

#resume-search > .input--placeholder {
    color: $c-muted;
}

/* Textual's Input tints the background 5% $foreground while focused, which
   renders as a darker box inside the surface modal; kill it (the resume
   search is focused essentially all the time). */
#resume-search:focus {
    background-tint: transparent;
}

#resume-list {
    background: $c-surface;
    border: none;
    padding: 0;
}

/* ListView defaults to height: 1fr + Textual's own dark $surface, which
   renders as a big dark block inside the auto-height modal. */
#picker-list {
    height: auto;
    max-height: 16;
    background: $c-surface;
    border: none;
    padding: 0;
}

#resume-list > ListItem,
#picker-list > ListItem {
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

#resume-list > ListItem.-highlight,
#picker-list > ListItem.-highlight {
    background: $c-border;
    color: $c-text;
}

#host-bash-bar {
    display: none;
    width: 1fr;
    height: auto;
    background: $c-surface;
    padding: 0;
}

#steer-queue-bar {
    display: none;
    height: auto;
    background: $c-surface;
    color: $c-muted;
    padding: 0 1;
}

#steer-queue-bar.visible {
    display: block;
    /* Separator between the queued messages and the input below. */
    border-bottom: solid $c-border;
}

#steer-queue-bar > .steer-item {
    width: 1fr;
}

#steer-queue-bar > .steer-hint {
    color: $c-accent2;
    text-style: italic;
}

#host-bash-bar.visible {
    display: block;
    layout: vertical;
    /* Separator between the prompt and the answer input below. */
    border-bottom: solid $c-warning;
}

#host-bash-body {
    height: auto;
    padding: 1 1;
}

#host-bash-title {
    color: $c-warning;
    text-style: bold;
    margin-bottom: 1;
}

#host-bash-command {
    color: $c-text;
    background: $c-bg;
    border-left: thick $c-warning;
    padding: 0 1;
    margin-bottom: 1;
}

#host-bash-reason {
    color: $c-muted;
}

#host-bash-buttons {
    height: auto;
    margin-top: 1;
}

#host-bash-buttons > Button {
    width: auto;
    min-width: 10;
    margin-right: 2;
    padding: 0 2;
    border: none;
    background: $c-border;
    color: $c-text;
}

#host-bash-buttons > Button:hover,
#host-bash-buttons > Button:focus {
    background: $c-highlight;
    color: $c-bg;
    text-style: bold;
}

#host-bash-buttons > Button#host-bash-once {
    background: $c-accent;
    color: $c-bg;
    text-style: bold;
}

#host-bash-buttons > Button#host-bash-once:hover,
#host-bash-buttons > Button#host-bash-once:focus {
    background: $c-accent2;
    color: $c-bg;
}

#host-bash-buttons > Button#host-bash-deny {
    background: $c-error;
    color: $c-bg;
    text-style: bold;
}

#host-bash-input {
    height: 1;
    border: none;
    background: $c-bg;
    color: $c-text;
    padding: 0 1;
    margin-top: 1;
}

ContentTab { background: #ff0000; color: #00ff00; }

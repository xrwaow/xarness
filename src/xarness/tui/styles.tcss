Screen {
    layout: vertical;
    background: $c-bg;
}

#chat-log {
    height: 1fr;
    padding: 0;
    background: $c-bg;
    scrollbar-size: 0 0; /* hide the scrollbar visual; wheel/key scrolling still works */
}

.msg {
    margin-bottom: 1;
}

UserMessage {
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 0;
}

.user-row {
    height: auto;
}

.user-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.user-content {
    width: 1fr;
    color: $c-text;
}

AssistantMessage {
    height: auto;
    color: $c-text;
    padding: 0 1;
}

.assistant-row {
    height: auto;
}

.assistant-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.assistant-live {
    width: 1fr;
    color: $c-text;
}

.assistant-md {
    width: 1fr;
    height: auto;
    color: $c-text;
    margin: 0;
    overflow-y: hidden;
}

.assistant-content {
    width: 1fr;
    height: auto;
}

ThinkingBlock,
PendingIndicator {
    height: auto;
    padding: 0 1;
}

.thinking-summary {
    height: auto;
}

.thinking-elapsed {
    color: $c-muted;
}

.thinking-done-summary {
    color: $c-muted;
}

.thinking-row {
    height: auto;
    display: none;
}

ThinkingBlock.expanded .thinking-row {
    display: block;
}

.thinking-marker {
    width: 2;
}

.thinking-text {
    width: 1fr;
    color: $c-reasoning;
    text-style: italic;
}

ThinkingBlock:hover .thinking-summary,
ToolCallBlock:hover .toolcall-summary {
    text-style: underline;
    color: $c-highlight;
}

.pending-elapsed {
    color: $c-muted;
}

ToolCallBlock {
    height: auto;
    padding: 0 1;
}

.toolcall-summary {
    height: auto;
}

.toolcall-dot {
    width: 1;
    margin-right: 1;
}

.toolcall-summary-text {
    color: $c-muted;
}

.toolcall-row {
    height: auto;
    display: none;
}

ToolCallBlock.expanded .toolcall-row {
    display: block;
}

.toolcall-marker {
    width: 2;
    border-left: solid $c-border;
}

.toolcall-body {
    width: 1fr;
    color: $c-muted;
}

ToolWritingIndicator {
    height: auto;
    padding: 0 1;
}

ErrorLine {
    color: $c-error;
}

NoticeLine {
    color: $c-muted;
}

StatusBar {
    height: 1;
    background: $c-bg;
    padding: 0 1;
}

#input-wrap {
    height: auto;
    padding: 0;
}

ChatInput {
    height: auto;
    min-height: 3;
    max-height: 8;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

MarkdownFence {
    margin: 0;
    background: $c-bg;
}

#code-content {
    padding: 1 0 !important;
}

MarkdownBlock {
    padding: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

Markdown {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

MarkdownDocument {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

/* List bullets/numbers render as plain text color, not the theme accent. */
MarkdownBullet {
    color: $c-text !important;
}

/* Text selection uses the theme's highlight color instead of Textual's blue. */
Screen > .screen--selection {
    background: $c-highlight;
    color: $c-bg;
}

SuggestionPopup {
    height: auto;
    max-height: 8;
    background: $c-surface;
    display: none;
    /* OptionList's default tall border + padding render as stray vertical
       bars against the input; keep the popup flat. */
    border: none;
    padding: 0;
    scrollbar-background: $c-surface;
    scrollbar-color: $c-border;
    scrollbar-background-hover: $c-surface;
    scrollbar-color-hover: $c-muted;
}

SuggestionPopup > .option-list--option {
    color: $c-text;
    padding: 0 1;
}

SuggestionPopup > .option-list--option-highlighted {
    background: $c-border;
    color: $c-text;
}

SuggestionPopup > .option-list--option-hover {
    background: $c-surface;
    color: $c-text;
}

SuggestionPopup.visible {
    display: block;
}

ResumeScreen, PickerScreen {
    align: center middle;
}

#resume-modal, #picker-modal {
    width: 64;
    height: auto;
    max-height: 20;
    background: $c-surface;
    border: round $c-border;
    padding: 1 2;
}

#resume-title, #picker-title {
    color: $c-muted;
    text-style: bold;
    margin-bottom: 1;
}

#resume-search {
    border: none;
    border-bottom: solid $c-border;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

#resume-search > .input--placeholder {
    color: $c-muted;
}

#resume-search:focus {
    border: none;
    border-bottom: solid $c-highlight;
}

#resume-list {
    background: $c-surface;
    border: none;
    padding: 0;
}

/* ListView defaults to height: 1fr + Textual's own dark $surface, which
   renders as a big dark block inside the auto-height modal. */
#picker-list {
    height: auto;
    max-height: 16;
    background: $c-surface;
    border: none;
    padding: 0;
}

#resume-list > ListItem,
#picker-list > ListItem {
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

#resume-list > ListItem.-highlight,
#picker-list > ListItem.-highlight {
    background: $c-border;
    color: $c-text;
}

#ask-modal {
    width: 64;
    height: auto;
    background: $c-surface;
    padding: 1 2;
}

.ask-question {
    color: $c-text;
    margin-bottom: 1;
}

#ask-modal > Input {
    border: none;
    border-bottom: solid $c-border;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

#ask-modal > Input:focus {
    border: none;
    border-bottom: solid $c-highlight;
}

.ask-hint {
    color: $c-muted;
}

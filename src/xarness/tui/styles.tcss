/* Hide every scrollbar app-wide; wheel/key scrolling still works. */
Widget {
    scrollbar-size: 0 0;
}

Screen {
    layout: vertical;
    background: $c-bg;
    /* The diff pane owns scrolling when a diff is open; never show the
       screen-level (outer) scrollbar next to it. Wheel/key scrolling of the
       screen still works if the content ever exceeds the terminal. */
    scrollbar-size: 0 0;
}

#chat-log {
    height: 1fr;
    padding: 0;
    background: $c-bg;
    scrollbar-size: 0 0; /* hide the scrollbar visual; wheel/key scrolling still works */
}

.msg {
    margin-bottom: 1;
}

UserMessage {
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 0;
}

.user-row {
    height: auto;
}

.user-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.user-content {
    width: 1fr;
    color: $c-text;
}

AssistantMessage {
    height: auto;
    color: $c-text;
    padding: 0 1;
}

.assistant-row {
    height: auto;
}

.assistant-marker {
    width: 1;
    margin-right: 1;
    color: $c-muted;
}

.assistant-live {
    width: 1fr;
    color: $c-text;
}

.assistant-md {
    width: 1fr;
    height: auto;
    color: $c-text;
    margin: 0;
    overflow-y: hidden;
}

.assistant-content {
    width: 1fr;
    height: auto;
}

ThinkingBlock,
PendingIndicator {
    height: auto;
    padding: 0 1;
}

.thinking-summary {
    height: auto;
}

.thinking-elapsed {
    color: $c-muted;
}

.thinking-done-summary {
    color: $c-muted;
}

.thinking-row {
    height: auto;
    display: none;
}

ThinkingBlock.expanded .thinking-row {
    display: block;
}

.thinking-marker {
    width: 2;
}

.thinking-text {
    width: 1fr;
    color: $c-reasoning;
    text-style: italic;
}

ThinkingBlock:hover .thinking-summary,
ToolCallBlock:hover .toolcall-summary {
    text-style: underline;
    color: $c-highlight;
}

.pending-elapsed {
    color: $c-muted;
}

ToolCallBlock {
    height: auto;
    padding: 0 1;
}

.toolcall-summary {
    height: auto;
}

.toolcall-dot {
    width: 1;
    margin-right: 1;
}

.toolcall-summary-text {
    color: $c-muted;
}

.toolcall-row {
    height: auto;
    display: none;
}

ToolCallBlock.expanded .toolcall-row {
    display: block;
}

.toolcall-marker {
    width: 2;
    border-left: solid $c-border;
}

.toolcall-body {
    width: 1fr;
    color: $c-muted;
}

ToolWritingIndicator {
    height: auto;
    padding: 0 1;
}

ErrorLine,
NoticeLine {
    padding: 0 1;
}

ErrorLine {
    color: $c-error;
}

NoticeLine {
    color: $c-muted;
}

StatusBar {
    height: 1;
    background: $c-bg;
    padding: 0;
}

GeneratingBar {
    display: none;
    width: auto;
    height: 1;
    color: $c-accent;
}

GeneratingBar.active {
    display: block;
}

#input-wrap {
    height: auto;
    padding: 0;
}

#input-row {
    height: auto;
    align-vertical: middle;
}

#input-prompt {
    width: 1;
    height: 100%;
    background: $c-surface;
    color: $c-muted;
    content-align: left middle;
}

ChatInput {
    height: auto;
    min-height: 3;
    max-height: 8;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 1 1 1 1;
}

MarkdownFence {
    margin: 0;
    background: $c-bg;
}

#code-content {
    padding: 1 0 !important;
}

MarkdownBlock {
    padding: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

Markdown {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

MarkdownDocument {
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: $c-bg;
}

/* List bullets/numbers render as plain text color, not the theme accent. */
MarkdownBullet {
    color: $c-text !important;
}

/* Textual styles inline code from its own theme's dark/light variant; we
   never register a Textual theme, so the dark variant (yellow on white)
   always wins. Pin it to the palette instead. !important beats the
   higher-specificity `MarkdownBlock:dark >` built-in rule. */
MarkdownBlock > .code_inline {
    background: $c-surface !important;
    color: $c-accent2 !important;
}

/* Text selection uses the theme's highlight color instead of Textual's blue. */
Screen > .screen--selection {
    background: $c-highlight;
    color: $c-bg;
}

SuggestionPopup {
    height: auto;
    max-height: 8;
    background: $c-surface;
    display: none;
    /* OptionList's default tall border + padding render as stray vertical
       bars against the input; keep the popup flat. The scrollbar visual is
       hidden too — arrow-key highlight (and the wheel) still scroll it. */
    border: none;
    padding: 0;
    scrollbar-size: 0 0;
}

SuggestionPopup > .option-list--option {
    color: $c-text;
    padding: 0 1;
}

SuggestionPopup > .option-list--option-highlighted {
    background: $c-border;
    color: $c-text;
}

SuggestionPopup > .option-list--option-hover {
    background: $c-surface;
    color: $c-text;
}

SuggestionPopup.visible {
    display: block;
}

DiffSummary {
    display: none;
    height: auto;
    background: $c-surface;
    padding: 0;
}

DiffSummary.visible {
    display: block;
    background: $c-bg;
}

#diff-summary-row {
    height: auto;
}

#diff-summary-text {
    width: 1fr;
    text-overflow: ellipsis;
    color: $c-text;
    text-style: bold;
}

#diff-summary-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

#diff-summary-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

DiffSummary:hover #diff-summary-row,
.diff-file-row:hover {
    text-style: underline;
}

AskBar {
    display: none;
    width: 1fr;
    height: auto;
    background: $c-surface;
    color: $c-text;
    padding: 1 1;
}

AskBar.visible {
    display: block;
    /* Separator between the question and the answer input below. */
    border-bottom: solid $c-border;
}

#diff-body {
    display: none;
    height: auto;
}

DiffSummary.expanded #diff-body {
    display: block;
}

#diff-files {
    height: auto;
}

.diff-file-row {
    height: auto;
}

.diff-file-row.active {
    background: $c-border;
}

.diff-file-name {
    width: 26;
    text-overflow: ellipsis;
    color: $c-text;
}

.diff-file-dir {
    width: 1fr;
    color: $c-muted;
    text-overflow: ellipsis;
}

.diff-file-new {
    width: auto;
    margin-left: 1;
    color: $c-accent;
    text-style: italic;
}

.diff-file-add {
    width: auto;
    margin-left: 2;
    color: $c-success;
}

.diff-file-del {
    width: auto;
    margin-left: 1;
    color: $c-error;
}

#diff-content {
    display: none;
    height: auto;
    max-height: 24;
    overflow-y: auto;
    /* No scrollbar visual: the pane stays keyboard/wheel scrollable, and the
       gutter would eat width from every diff line. */
    scrollbar-size: 0 0;
    /* Textual shows a spurious horizontal scrollbar on scroll containers
       even with no horizontal overflow; diff lines wrap, so it is useless. */
    overflow-x: hidden;
    color: $c-text;
    background: $c-bg;
    border-top: solid $c-border;
}

#diff-content.show {
    display: block;
}

#diff-content:focus {
    border-top: solid $c-status;
}

#diff-text {
    width: 1fr;
}

#confirm-modal {
    width: 64;
    height: auto;
    background: $c-surface;
    padding: 1 2;
}

#confirm-title {
    color: $c-error;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-detail {
    color: $c-text;
    margin-bottom: 1;
}

#confirm-modal > Input {
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

#confirm-modal > Input:focus {
    border: none;
}

ResumeScreen, PickerScreen {
    align: center middle;
}

#resume-modal, #picker-modal {
    width: 64;
    height: auto;
    max-height: 20;
    background: $c-surface;
    padding: 1 2;
}

#resume-title, #picker-title {
    color: $c-muted;
    text-style: bold;
    margin-bottom: 1;
}

#resume-search {
    height: 1;
    border: none;
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
    margin-bottom: 1;
}

#resume-search > .input--placeholder {
    color: $c-muted;
}

/* Textual's Input tints the background 5% $foreground while focused, which
   renders as a darker box inside the surface modal; kill it (search +
   confirm inputs are focused essentially all the time). */
#resume-search:focus,
#confirm-modal > Input:focus {
    background-tint: transparent;
}

#resume-list {
    background: $c-surface;
    border: none;
    padding: 0;
}

/* ListView defaults to height: 1fr + Textual's own dark $surface, which
   renders as a big dark block inside the auto-height modal. */
#picker-list {
    height: auto;
    max-height: 16;
    background: $c-surface;
    border: none;
    padding: 0;
}

#resume-list > ListItem,
#picker-list > ListItem {
    background: $c-surface;
    color: $c-text;
    padding: 0 1;
}

#resume-list > ListItem.-highlight,
#picker-list > ListItem.-highlight {
    background: $c-border;
    color: $c-text;
}
